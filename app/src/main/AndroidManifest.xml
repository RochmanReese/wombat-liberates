<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Short buzz when a scan pauses to ask a question. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- "Cleanup finished" notifications from the background server check (asked for on first use). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional: turn on Do Not Disturb during a scan (the user grants this in Settings). -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher_wombat"
        android:roundIcon="@mipmap/ic_launcher_wombat"
        android:label="Wombat Liberates"
        android:theme="@style/Theme.WombatLiberates">
        <activity
            android:name=".HelpActivity"
            android:exported="false" />

        <activity
            android:name=".ReviewActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".KindleAccessibilityProbeService"
            android:label="Wombat Liberates"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_probe_config" />
        </service>
    </application>
</manifest>
