<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kindle accessibility probe"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="First collect a user-authorized Kindle range as raw local OCR. Return here afterward to correct the saved text; raw OCR is always retained separately. Screenshots are discarded."
            android:textSize="16sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Probe: stopped"
            android:textStyle="bold" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Start accessibility probe" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Stop probe and capture" />

        <EditText
            android:id="@+id/pageCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Screens to capture (1–1,000)"
            android:inputType="number"
            android:singleLine="true"
            android:text="10" />

        <Button
            android:id="@+id/startBookCaptureButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Start automatic raw book capture" />

        <Button
            android:id="@+id/stopBatchButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Stop automatic capture" />

        <Button
            android:id="@+id/correctOnDeviceButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Correct saved OCR on this device" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="On-device correction requires a compatible Gemini Nano device."
            android:textSize="12sp" />

        <EditText
            android:id="@+id/ollamaBaseUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Ollama HTTPS base URL"
            android:inputType="textUri"
            android:singleLine="true" />

        <EditText
            android:id="@+id/ollamaModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Ollama model"
            android:inputType="text"
            android:singleLine="true"
            android:text="mistral-nemo:latest" />

        <EditText
            android:id="@+id/ollamaUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Ollama username"
            android:inputType="text"
            android:singleLine="true" />

        <EditText
            android:id="@+id/ollamaPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Ollama password"
            android:inputType="textPassword"
            android:singleLine="true" />

        <Button
            android:id="@+id/correctOllamaButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Correct saved OCR via Ollama" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Connection settings stay on this phone; the password is encrypted with Android Keystore and is never committed."
            android:textSize="12sp" />

        <Button
            android:id="@+id/armTreeSnapshotButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Arm next Kindle tree snapshot" />

        <Button
            android:id="@+id/armOcrButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Arm one-page OCR capture" />

        <Button
            android:id="@+id/clearLogButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Clear raw OCR, corrected OCR, and diagnostics" />

        <EditText
            android:id="@+id/exportFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Export filename"
            android:inputType="text"
            android:singleLine="true"
            android:text="kindle-ocr.txt" />

        <Button
            android:id="@+id/saveRawTextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Save raw OCR text" />

        <Button
            android:id="@+id/saveCorrectedTextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Save corrected OCR text" />

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:text="No events logged."
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
