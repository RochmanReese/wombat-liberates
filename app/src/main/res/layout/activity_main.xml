<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:adjustViewBounds="true"
            android:contentDescription="Wombat Liberates"
            android:scaleType="centerCrop"
            android:src="@drawable/wombat_banner" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Wombat Liberates"
                android:textSize="28sp"
                android:textStyle="bold" />


        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Read Your Books, Your Way."
            android:textSize="16sp" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1. Scan or import"
                android:textSize="20sp"
                android:textStyle="bold" />


            <Button
                android:id="@+id/helpButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Help" />
        </LinearLayout>

        <Button
            android:id="@+id/startBookCaptureButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Start Kindle scan" />

        <Button
            android:id="@+id/stopBatchButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Stop scan" />

        <Button
            android:id="@+id/importRawTextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Import text file" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Ready to scan or import."
            android:textSize="12sp" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Scans until Kindle reaches the end of the book. Screenshots are OCRed locally, then discarded."
            android:textSize="12sp" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="2. Review and improve"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bookQualityText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="No book text yet."
            android:textSize="14sp" />

        <Button
            android:id="@+id/reviewBookButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Review, compare and save" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Text is cleaned on your phone automatically. Ollama is optional and only needed if the quality check says the OCR is poor."
            android:textSize="12sp" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="3. Create EPUB"
            android:textSize="20sp"
            android:textStyle="bold" />


        <EditText
            android:id="@+id/epubTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Book title"
            android:inputType="textCapSentences"
            android:singleLine="true" />

        <EditText
            android:id="@+id/epubAuthor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Author"
            android:inputType="textCapWords"
            android:singleLine="true" />

        <Button
            android:id="@+id/exportEpubButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Create EPUB" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Uses the version chosen in Review (device cleanup unless you pick another). Chapter headings become the contents list."
            android:textSize="12sp" />


        <Button
            android:id="@+id/advancedControlsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Show advanced settings and diagnostics" />

        <LinearLayout
            android:id="@+id/advancedControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Scan settings"
                android:textSize="18sp"
                android:textStyle="bold" />


            <EditText
                android:id="@+id/pageCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Maximum screens (blank = whole book)"
                android:inputType="number"
                android:singleLine="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="The app stops by itself at the end of a book. Leave this blank unless you want to capture only part of one."
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Pages with tables"
                android:textSize="16sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/tableModeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/tableModeAsk"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ask me (the scan pauses on each table)" />

                <RadioButton
                    android:id="@+id/tableModeKeep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Always keep table text" />

                <RadioButton
                    android:id="@+id/tableModeSkip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Always skip tables" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tables are read row by row. Choose Keep or Skip to leave a long scan running unattended."
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Test scan"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Scans a few pages, cleans them on your phone and opens the review screen, where you can view, save and compare the result, and try Ollama only if needed. Test text is kept separate and does not affect your book scan."
                android:textSize="12sp" />

            <EditText
                android:id="@+id/testPageCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Test screens (10 to 100)"
                android:inputType="number"
                android:singleLine="true"
                android:text="20" />

            <Button
                android:id="@+id/startTestScanButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Start test scan" />

            <Button
                android:id="@+id/viewTestResultsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="View last test results" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="OCR corrections"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Added corrections are literal and case-sensitive. They run after the built-in fixes and default corrections on the next Quick local cleanup."
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/ocrCorrectionsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <EditText
                android:id="@+id/ocrCorrectionFind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Find"
                android:inputType="text"
                android:singleLine="true" />

            <EditText
                android:id="@+id/ocrCorrectionReplace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Replace (may be empty)"
                android:inputType="text"
                android:singleLine="true" />

            <Button
                android:id="@+id/addOcrCorrectionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Add correction" />

            <Button
                android:id="@+id/resetOcrCorrectionsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Reset custom corrections" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Ollama connection"

                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/ollamaBaseUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Ollama HTTPS base URL"
                android:inputType="textUri"
                android:singleLine="true" />

            <EditText
                android:id="@+id/ollamaModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Ollama model"
                android:inputType="text"
                android:singleLine="true"
                android:text="mistral-nemo:latest" />

            <EditText
                android:id="@+id/ollamaUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Ollama username"
                android:inputType="text"
                android:singleLine="true" />

            <EditText
                android:id="@+id/ollamaPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Ollama password"
                android:inputType="textPassword"
                android:singleLine="true" />

            <Button
                android:id="@+id/saveOllamaSettingsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Save Ollama settings" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Ollama is used only when you choose it on the review screen. The password is stored encrypted on this phone."
                android:textSize="12sp" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Accessibility and files"
                android:textSize="18sp"
                android:textStyle="bold" />


            <Button
                android:id="@+id/startButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Enable scanning service" />

            <Button
                android:id="@+id/stopButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Stop scan service" />

            <EditText
                android:id="@+id/exportFileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Text export filename"
                android:inputType="text"
                android:singleLine="true"
                android:text="kindle-ocr.txt" />

            <Button
                android:id="@+id/saveRawTextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Save raw OCR text" />

            <Button
                android:id="@+id/clearLogButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Clear all saved text and diagnostics" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Diagnostics"
                android:textSize="18sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/logText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:text="No events logged."
                android:textIsSelectable="true"
                android:textSize="12sp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
